generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  SALES
  MARKETING
}

enum ConnectorKind {
  AI_PROVIDER
  DATA_SOURCE
  COMMUNICATION
  CRM
  BROWSER_AUTOMATION
}

enum ConnectorStatus {
  DISCONNECTED
  CONNECTED
  NEEDS_ATTENTION
  REVOKED
}

enum PlatformCredentialProvider {
  GEMINI
  APIFY
  MANUS
}

enum PlatformCredentialStatus {
  CONNECTED
  LIMIT_REACHED
  ERROR
}

enum ConfidenceLevel {
  CONFIRMED
  LIKELY
  INFERENCE
  UNVERIFIED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  CANCELED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                  String                    @id @default(cuid())
  name                String?
  email               String                    @unique
  emailVerified       DateTime?
  image               String?
  active              Boolean                   @default(true)
  isAdmin             Boolean                   @default(false)
  lastLoginAt         DateTime?
  professionalProfile ProfessionalProfile?
  modulePermissions   UserModulePermission[]
  memberships         Membership[]
  credentials         UserConnectorCredential[]
  skillRuns           SkillRun[]
  assessments         AuthorityAssessment[]
  hrHuntingSearches   HrHuntingSearch[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
}

model HrHuntingSearch {
  id                    String               @id @default(cuid())
  ownerId               String
  title                 String
  jobDescription        String
  jobUrl                String?
  companyName           String?
  recruiterName         String?
  jobDna                Json
  searchTerms           String[]
  status                String               @default("job_dna_ready")
  sourceSnapshot        Json?
  connectorWarnings     String[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  owner                 User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  candidates            HrHuntingCandidate[]

  @@index([ownerId, updatedAt])
}

model HrHuntingCandidate {
  id                    String                       @id @default(cuid())
  searchId              String
  profileId             String?
  sourcePersonId        String?
  name                  String
  currentTitle          String?
  currentCompany        String?
  location              String?
  profileUrl            String?
  professionalSummary   String?
  fitScore              Int
  fitClassification     String
  mainSignal            String?
  pointsToValidate      String[]
  sourceName            String
  confidence            ConfidenceLevel              @default(UNVERIFIED)
  rawSnapshot           Json
  search                HrHuntingSearch              @relation(fields: [searchId], references: [id], onDelete: Cascade)
  evidence              HrHuntingCandidateEvidence[]
  contacts              HrHuntingCandidateContact[]
  shortlist             HrHuntingShortlist?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  @@unique([searchId, profileUrl])
  @@index([searchId, fitScore])
  @@index([profileId])
}

model HrHuntingCandidateEvidence {
  id                    String               @id @default(cuid())
  candidateId           String
  criterion             String
  criterionType         String
  result                String
  evidence              String?
  source                String
  confidence            ConfidenceLevel
  candidate             HrHuntingCandidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt             DateTime             @default(now())
}

model HrHuntingCandidateContact {
  id                    String               @id @default(cuid())
  candidateId           String
  value                 String
  type                  String
  source                String
  confidence            ConfidenceLevel
  obtainedAt            DateTime?
  candidate             HrHuntingCandidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt             DateTime             @default(now())
}

model HrHuntingShortlist {
  id                    String               @id @default(cuid())
  candidateId           String               @unique
  nextStep              String?
  notes                 String?
  candidate             HrHuntingCandidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model HrCandidateProfile {
  id                    String          @id @default(cuid())
  profileKey            String          @unique
  linkedinUrl           String?         @unique
  sourcePersonId        String?
  name                  String
  currentTitle          String?
  currentCompany        String?
  location              String?
  professionalSummary   String?
  sourceName            String?
  confidence            ConfidenceLevel @default(UNVERIFIED)
  rawSnapshot           Json            @default("{}")
  lastExternalLookupAt  DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([currentTitle])
  @@index([currentCompany])
  @@index([lastExternalLookupAt])
}

model HrCandidateReview {
  id                    String   @id @default(cuid())
  profileId             String
  reviewerId            String
  reviewerName          String
  verdict               String
  note                  String?
  searchId              String?
  searchTitle           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([profileId, createdAt])
  @@index([reviewerId, createdAt])
}

model B2BWorkspaceSearch {
  id                 String          @id @default(cuid())
  ownerId            String
  ownerName          String
  mode               String
  title              String
  businessUnitId     String
  objective          String
  queryHash          String
  input              Json
  resultSnapshot     Json
  resultCount        Int             @default(0)
  reusedFromSearchId String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  leads              B2BSearchLead[]

  @@index([queryHash, updatedAt])
  @@index([ownerId, updatedAt])
  @@index([mode, updatedAt])
}

model B2BLead {
  id                String            @id @default(cuid())
  leadKey           String            @unique
  kind              String
  name              String
  companyName       String?
  title             String?
  linkedinUrl       String?
  domain            String?
  website           String?
  location          String?
  firstSeenById     String
  firstSeenByName   String
  firstSeenSearchId String?
  payload           Json
  lastSeenAt        DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  searches          B2BSearchLead[]
  listItems         B2BLeadListItem[]

  @@index([kind, updatedAt])
  @@index([firstSeenById, updatedAt])
  @@index([linkedinUrl])
  @@index([domain])
}

model B2BSearchLead {
  id        String             @id @default(cuid())
  searchId  String
  leadId    String
  search    B2BWorkspaceSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  lead      B2BLead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@unique([searchId, leadId])
  @@index([leadId])
}

model B2BLeadList {
  id        String            @id @default(cuid())
  name      String
  ownerId   String
  ownerName String
  shared    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  items     B2BLeadListItem[]

  @@index([ownerId, updatedAt])
}

model B2BLeadListItem {
  id          String      @id @default(cuid())
  listId      String
  leadId      String
  addedById   String
  addedByName String
  list        B2BLeadList @relation(fields: [listId], references: [id], onDelete: Cascade)
  lead        B2BLead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@unique([listId, leadId])
  @@index([leadId])
}

model WhatsCampaign {
  id              String          @id @default(cuid())
  ownerId         String
  ownerName       String
  title           String
  baseText        String
  tone            String          @default("Profissional e acolhedor")
  status          String          @default("draft")
  sourceFileName  String?
  mapping         Json            @default("{}")
  totalRecipients Int             @default(0)
  generatedCount  Int             @default(0)
  sentCount       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  recipients      WhatsRecipient[]

  @@index([ownerId, updatedAt])
  @@index([status, updatedAt])
}

model WhatsRecipient {
  id          String        @id @default(cuid())
  campaignId  String
  rowNumber   Int
  name        String
  phone       String
  job         String
  rawData     Json          @default("{}")
  message     String?
  status      String        @default("pending")
  generatedAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  campaign    WhatsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, rowNumber])
  @@index([campaignId, status])
}

model ProfessionalProfile {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  linkedinUrl             String?
  linkedinUpdatedAt       DateTime?
  lastAuthorityAnalysisAt DateTime?
  latestLinkedinSnapshot  Json?
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model UserModulePermission {
  id        String   @id @default(cuid())
  userId    String
  moduleKey String
  enabled   Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, moduleKey])
  @@index([moduleKey, enabled])
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  memberships   Membership[]
  businessUnits BusinessUnit[]
  connectors    Connector[]
  skills        Skill[]
  auditLogs     AuditLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           Role           @default(SALES)
  businessUnits  BusinessUnit[]
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, organizationId])
}

model BusinessUnit {
  id                   String                           @id @default(cuid())
  organizationId       String
  name                 String
  slug                 String
  active               Boolean                          @default(true)
  publicationStatus    PublicationStatus                @default(PUBLISHED)
  dnaVersion           Int                              @default(1)
  organization         Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships          Membership[]
  brandPack            BrandPack?
  products             BusinessUnitProduct[]
  icps                 BusinessUnitIcp[]
  personas             BusinessUnitPersona[]
  authorityTerritories BusinessUnitAuthorityTerritory[]
  contentDna           BusinessUnitContentDna?
  claims               BusinessUnitClaim[]
  documents            Document[]
  skillRuns            SkillRun[]
  assessments          AuthorityAssessment[]
  content              ContentOpportunity[]
  calendar             CalendarOpportunity[]
  companies            ProspectCompany[]
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt

  @@unique([organizationId, slug])
}

model BusinessUnitProduct {
  id             String            @id @default(cuid())
  businessUnitId String
  name           String
  description    String
  problems       String[]
  audiences      String[]
  benefits       String[]
  proofPoints    String[]
  objections     String[]
  cta            String?
  keywords       String[]
  status         PublicationStatus @default(DRAFT)
  metadata       Json              @default("{}")
  businessUnit   BusinessUnit      @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([businessUnitId, name])
}

model BusinessUnitIcp {
  id              String            @id @default(cuid())
  businessUnitId  String
  name            String
  sectors         String[]
  companySize     String?
  regions         String[]
  maturity        String?
  problems        String[]
  positiveSignals String[]
  negativeSignals String[]
  buyingAreas     String[]
  decisionMakers  String[]
  influencers     String[]
  champions       String[]
  status          PublicationStatus @default(DRAFT)
  metadata        Json              @default("{}")
  businessUnit    BusinessUnit      @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([businessUnitId, name])
}

model BusinessUnitPersona {
  id                   String            @id @default(cuid())
  businessUnitId       String
  name                 String
  responsibilities     String[]
  kpis                 String[]
  pains                String[]
  objectives           String[]
  objections           String[]
  language             String[]
  conversationTriggers String[]
  relatedProducts      String[]
  status               PublicationStatus @default(DRAFT)
  metadata             Json              @default("{}")
  businessUnit         BusinessUnit      @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([businessUnitId, name])
}

model BusinessUnitAuthorityTerritory {
  id              String            @id @default(cuid())
  businessUnitId  String
  name            String
  description     String
  importance      String
  keywords        String[]
  subthemes       String[]
  evidenceTypes   String[]
  forbiddenThemes String[]
  status          PublicationStatus @default(DRAFT)
  metadata        Json              @default("{}")
  businessUnit    BusinessUnit      @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([businessUnitId, name])
}

model BusinessUnitContentDna {
  id                  String            @id @default(cuid())
  businessUnitId      String            @unique
  tone                String
  formality           String
  personality         String[]
  argumentStyle       String[]
  preferredStructures String[]
  recommendedTerms    String[]
  forbiddenTerms      String[]
  recommendedCtas     String[]
  forbiddenCtas       String[]
  prioritySubjects    String[]
  sensitiveSubjects   String[]
  metadata            Json              @default("{}")
  status              PublicationStatus @default(DRAFT)
  businessUnit        BusinessUnit      @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model BusinessUnitClaim {
  id             String            @id @default(cuid())
  businessUnitId String
  claim          String
  source         String?
  kind           String            @default("approved")
  status         PublicationStatus @default(DRAFT)
  metadata       Json              @default("{}")
  businessUnit   BusinessUnit      @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model BrandPack {
  id             String       @id @default(cuid())
  businessUnitId String       @unique
  name           String
  visualTokens   Json
  voiceTokens    Json
  context        Json
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Document {
  id             String       @id @default(cuid())
  businessUnitId String
  title          String
  kind           String
  storageUrl     String?
  extractedText  String?
  metadata       Json         @default("{}")
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Connector {
  id             String                    @id @default(cuid())
  organizationId String
  key            String
  name           String
  kind           ConnectorKind
  capabilities   String[]
  status         ConnectorStatus           @default(DISCONNECTED)
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credentials    UserConnectorCredential[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([organizationId, key])
}

model UserConnectorCredential {
  id          String          @id @default(cuid())
  userId      String
  connectorId String
  label       String
  encrypted   String
  scopes      String[]
  status      ConnectorStatus @default(CONNECTED)
  revokedAt   DateTime?
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  connector   Connector       @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model PlatformCredential {
  id              String                     @id @default(cuid())
  provider        PlatformCredentialProvider @unique
  encrypted       String
  masked          String
  status          PlatformCredentialStatus   @default(CONNECTED)
  lastValidatedAt DateTime?
  lastError       String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
}

model AuthorityAssessmentSnapshot {
  id             String   @id
  ownerId        String
  ownerEmail     String?
  subjectName    String?
  businessUnitId String
  profileUrl     String?
  schemaVersion  Int      @default(1)
  sourceSnapshot Json?
  assessment     Json
  plan30Days     Json?
  createdAt      DateTime
  updatedAt      DateTime @updatedAt

  @@index([ownerId, businessUnitId, createdAt])
}

model Skill {
  id                   String       @id @default(cuid())
  organizationId       String
  key                  String
  name                 String
  active               Boolean      @default(true)
  requiredCapabilities String[]
  definition           Json
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs                 SkillRun[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@unique([organizationId, key])
}

model SkillRun {
  id             String               @id @default(cuid())
  skillId        String
  userId         String
  businessUnitId String
  objective      String
  input          Json
  output         Json?
  status         String               @default("completed")
  confidence     Int                  @default(0)
  skill          Skill                @relation(fields: [skillId], references: [id])
  user           User                 @relation(fields: [userId], references: [id])
  businessUnit   BusinessUnit         @relation(fields: [businessUnitId], references: [id])
  assessment     AuthorityAssessment?
  auditLogs      AuditLog[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model AuthorityAssessment {
  id              String                    @id @default(cuid())
  skillRunId      String?                   @unique
  userId          String
  businessUnitId  String
  profileUrl      String?
  objective       String
  overallScore    Int
  summary         String
  strengths       String[]
  gaps            String[]
  risks           String[]
  opportunities   String[]
  recommendations String[]
  plan30Days      Json
  sources         ResearchSource[]
  dimensions      AuthorityDimensionScore[]
  skillRun        SkillRun?                 @relation(fields: [skillRunId], references: [id])
  user            User                      @relation(fields: [userId], references: [id])
  businessUnit    BusinessUnit              @relation(fields: [businessUnitId], references: [id])
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
}

model AuthorityDimensionScore {
  id           String              @id @default(cuid())
  assessmentId String
  key          String
  label        String
  score        Int
  rationale    String
  evidence     String[]
  assessment   AuthorityAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model AuthorityPlan {
  id             String   @id @default(cuid())
  businessUnitId String
  userId         String
  title          String
  weeks          Json
  status         String   @default("draft")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ContentOpportunity {
  id             String          @id @default(cuid())
  businessUnitId String
  title          String
  objective      String
  confidence     ConfidenceLevel
  payload        Json
  businessUnit   BusinessUnit    @relation(fields: [businessUnitId], references: [id])
  createdAt      DateTime        @default(now())
}

model CalendarOpportunity {
  id             String          @id @default(cuid())
  businessUnitId String
  date           DateTime
  title          String
  opportunity    String
  confidence     ConfidenceLevel
  payload        Json
  businessUnit   BusinessUnit    @relation(fields: [businessUnitId], references: [id])
}

model ProspectCompany {
  id             String           @id @default(cuid())
  businessUnitId String
  name           String
  site           String?
  score          Int
  confidence     ConfidenceLevel
  payload        Json
  businessUnit   BusinessUnit     @relation(fields: [businessUnitId], references: [id])
  people         ProspectPerson[]
  sources        ResearchSource[]
  createdAt      DateTime         @default(now())
}

model ProspectPerson {
  id         String          @id @default(cuid())
  companyId  String
  name       String
  role       String?
  profileUrl String?
  payload    Json
  company    ProspectCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model ResearchSource {
  id           String               @id @default(cuid())
  title        String
  url          String?
  publisher    String?
  confidence   ConfidenceLevel
  notes        String?
  assessmentId String?
  companyId    String?
  assessment   AuthorityAssessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  company      ProspectCompany?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())
}

model RapportReport {
  id        String   @id @default(cuid())
  payload   Json
  createdAt DateTime @default(now())
}

model AidaSequence {
  id        String   @id @default(cuid())
  payload   Json
  createdAt DateTime @default(now())
}

model MeetingBrief {
  id        String   @id @default(cuid())
  payload   Json
  createdAt DateTime @default(now())
}

model ApprovalRequest {
  id          String         @id @default(cuid())
  actionKey   String
  title       String
  preview     Json
  status      ApprovalStatus @default(PENDING)
  requestedBy String
  approvedBy  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model AppAuditLog {
  id            String   @id @default(cuid())
  actorUserId   String?
  actorName     String?
  actorEmail    String?
  moduleKey     String
  action        String
  entityType    String?
  entityId      String?
  severity      String   @default("info")
  retentionDays Int      @default(7)
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([moduleKey, createdAt])
  @@index([actorUserId, createdAt])
  @@index([severity, createdAt])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  skillRunId     String?
  actorUserId    String?
  action         String
  metadata       Json         @default("{}")
  organization   Organization @relation(fields: [organizationId], references: [id])
  skillRun       SkillRun?    @relation(fields: [skillRunId], references: [id])
  createdAt      DateTime     @default(now())
}

// MKT Scout snapshots and owner-scoped generations. Additive, no relations to other modules.
model MktScoutRecord {
  id        String   @id
  kind      String
  ownerId   String   @default("")
  cacheKey  String
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime?

  @@index([kind, ownerId, updatedAt])
  @@index([expiresAt])
}
